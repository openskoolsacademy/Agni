{
  "name": "ai-chatbot-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Embeddable AI Chatbot Platform with Gemini & Supabase",
  "scripts": {
    "dev": "npx concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:widget": "cd widget && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:widget": "cd widget && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:widget && npm run build:backend && npm run build:frontend",
    "start": "cd backend && npm start"
  },
  "keywords": ["ai", "chatbot", "gemini", "supabase", "embeddable-widget"],
  "author": "",
  "license": "ISC"
}
